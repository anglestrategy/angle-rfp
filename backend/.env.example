# Backend configuration (Vercel / local)

# REQUIRED in production:
# Comma-separated list of allowed Bearer tokens for app clients.
BACKEND_APP_TOKENS="replace-with-a-long-random-token,another-token-if-needed"
GOOGLE_API_KEY=""
# Optional fallback alias:
GEMINI_API_KEY=""
# Optional alias used in some Google SDK examples:
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional advanced model overrides.
# Leave unset unless you must pin a different model.
# Recommended:
# GEMINI_MODEL_FLASH="gemini-2.5-flash"
# Use plain model ID only (no "models/" prefix, no provider namespace).
GEMINI_MODEL_FLASH=""

# Optional: research providers
BRAVE_SEARCH_API_KEY=""
TAVILY_API_KEY=""
EXA_API_KEY=""
FIRECRAWL_API_KEY=""

# Optional: share-link base for export payloads (used in /api/export)
SHARE_LINK_BASE_URL="https://your-domain.example"

# Optional: budget / rate limits (defaults are safe for local dev)
BUDGET_TOKENS_PER_ANALYSIS="220000"
BUDGET_OCR_PAGES_PER_ANALYSIS="120"
BUDGET_QUERIES_PER_ANALYSIS="24"
BUDGET_DAILY_ANALYSES_PER_USER="20"
RATE_LIMIT_CAPACITY="120"
RATE_LIMIT_REFILL_PER_SECOND="2"

# Optional OCR provider (backend parse-document).
# Preferred production OCR path (bilingual/layout aware):
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
AZURE_DOCUMENT_INTELLIGENCE_KEY=""
# Optional API version override (default is set in code):
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION="2024-11-30"

# Optional OCR timeouts (ms) for Azure provider:
OCR_AZURE_SUBMIT_TIMEOUT_MS="45000"
OCR_AZURE_POLL_TIMEOUT_MS="15000"
OCR_AZURE_POLL_INTERVAL_MS="1500"
OCR_AZURE_MAX_POLL_ATTEMPTS="30"

# Legacy OCR key (kept for compatibility only; not used as primary provider):
GOOGLE_VISION_API_KEY=""
# Optional ADC credential path for Google Vision.
GOOGLE_APPLICATION_CREDENTIALS=""
# Optional explicit auth routing for Google Vision: auto | api_key | adc
GOOGLE_VISION_AUTH_MODE="auto"

# Optional premium parser (recommended for table-heavy / mixed-layout RFP PDFs and DOCX)
UNSTRUCTURED_API_KEY=""
# Optional custom endpoint (default: https://api.unstructuredapp.io/general/v0/general)
UNSTRUCTURED_API_URL=""

# Optional capability profile override (default: inferred from taxonomy)
# true => market research can be treated in-scope; false => market research forced out-of-scope.
AGENCY_SUPPORTS_MARKET_RESEARCH=""

# Optional: enable model-driven beautification pass.
# Default is deterministic formatter (recommended for consistency and latency).
ENABLE_MODEL_BEAUTIFY="0"
# Optional: disable beautification step entirely (0/1 flag inversion style).
# Keep enabled in production unless debugging.
ENABLE_TEXT_BEAUTIFIER="1"
# Optional: allow deterministic regex fallback if AI extraction fails.
# Keep "0" in production high-assurance mode to avoid low-quality copy/paste outputs.
RFP_ALLOW_REGEX_FALLBACK="0"
# Optional: allow heuristic deliverable synthesis when AI extraction is sparse.
# Default behavior in high-assurance mode is AI-first (disabled unless set to "1").
ALLOW_HEURISTIC_DELIVERABLE_FALLBACK="0"
# Optional: force parse-time text truncation. Disabled by default in high_assurance mode.
ALLOW_PARSE_TRUNCATION="0"
# Optional: final AI wrapper refinement pass (recommended ON in production).
RFP_AI_WRAPPER_REFINEMENT="1"

# Optional extraction orchestration tuning (full-document AI extraction windows):
EXTRACTION_MODEL_TIMEOUT_MS="180000"
EXTRACTION_WINDOW_TIMEOUT_MS="120000"
EXTRACTION_WINDOW_CONCURRENCY="2"
EXTRACTION_WINDOW_MAX_CHUNKS="5"
EXTRACTION_WINDOW_CONTEXT_CHARS="400000"
EXTRACTION_CHUNK_SIZE_CHARS="24000"
EXTRACTION_CHUNK_OVERLAP_CHARS="2400"
EXTRACTION_TOTAL_TIMEOUT_MS="540000"
EXTRACTION_WINDOW_RETRIES="1"
EXTRACTION_WINDOW_SPLIT_DEPTH="1"
EXTRACTION_MIN_COVERAGE="0.98"
EXTRACTION_PROJECT_DESCRIPTION_MAX_CHARS="6000"
EXTRACTION_SCOPE_MAX_CHARS="24000"
EXTRACTION_EVALUATION_MAX_CHARS="24000"
EXTRACTION_MAX_DELIVERABLES_PER_CATEGORY="20"
EXTRACTION_MAX_SCOPE_ITEMS="80"
# Optional AI wrapper refinement tuning
EXTRACTION_AI_WRAPPER_TIMEOUT_MS="120000"
EXTRACTION_AI_WRAPPER_HEAD_CHARS="45000"
EXTRACTION_AI_WRAPPER_TAIL_CHARS="14000"
SCOPE_MATCH_CONCURRENCY="2"
SCOPE_MATCH_BATCH_SIZE="6"

# Optional hard timeout for async extraction job worker.
ANALYZE_JOB_TIMEOUT_MS="1200000"
