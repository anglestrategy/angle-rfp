# Backend configuration (Vercel / local)

# REQUIRED in production:
# Comma-separated list of allowed Bearer tokens for app clients.
BACKEND_APP_TOKENS="replace-with-a-long-random-token,another-token-if-needed"
ANTHROPIC_API_KEY=""

# Optional advanced model overrides.
# Leave unset unless you must pin a different model.
# Do NOT use deprecated aliases such as claude-sonnet-4-5-latest / claude-haiku-4-5-latest.
# Recommended values (if you need explicit pinning):
# CLAUDE_MODEL_SONNET="claude-sonnet-4-5-20250929"
# CLAUDE_MODEL_HAIKU="claude-haiku-4-5-20251001"
CLAUDE_MODEL_SONNET=""
CLAUDE_MODEL_HAIKU=""

# Optional: research providers
BRAVE_SEARCH_API_KEY=""
TAVILY_API_KEY=""
EXA_API_KEY=""
FIRECRAWL_API_KEY=""

# Optional: share-link base for export payloads (used in /api/export)
SHARE_LINK_BASE_URL="https://your-domain.example"

# Optional: budget / rate limits (defaults are safe for local dev)
BUDGET_TOKENS_PER_ANALYSIS="220000"
BUDGET_OCR_PAGES_PER_ANALYSIS="120"
BUDGET_QUERIES_PER_ANALYSIS="24"
BUDGET_DAILY_ANALYSES_PER_USER="20"
RATE_LIMIT_CAPACITY="120"
RATE_LIMIT_REFILL_PER_SECOND="2"

# Optional OCR provider (backend parse-document).
# Preferred production OCR path (bilingual/layout aware):
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
AZURE_DOCUMENT_INTELLIGENCE_KEY=""
# Optional API version override (default is set in code):
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION="2024-11-30"

# Optional OCR timeouts (ms) for Azure provider:
OCR_AZURE_SUBMIT_TIMEOUT_MS="45000"
OCR_AZURE_POLL_TIMEOUT_MS="15000"
OCR_AZURE_POLL_INTERVAL_MS="1500"
OCR_AZURE_MAX_POLL_ATTEMPTS="30"

# Legacy OCR key (kept for compatibility only; not used as primary provider):
GOOGLE_VISION_API_KEY=""

# Optional premium parser (recommended for table-heavy / mixed-layout RFP PDFs and DOCX)
UNSTRUCTURED_API_KEY=""
# Optional custom endpoint (default: https://api.unstructuredapp.io/general/v0/general)
UNSTRUCTURED_API_URL=""

# Optional capability profile override (default: inferred from taxonomy)
# true => market research can be treated in-scope; false => market research forced out-of-scope.
AGENCY_SUPPORTS_MARKET_RESEARCH=""

# Optional: enable additional Claude beautification pass.
# Default is deterministic formatter (recommended for consistency and latency).
ENABLE_CLAUDE_BEAUTIFY="0"
